#--------------------------------
# Pages

    # Installer pages
    !insertmacro MUI_PAGE_LICENSE "gpl-2.0.txt"
    !insertmacro MUI_PAGE_DIRECTORY
    !insertmacro MUI_PAGE_STARTMENU Application $StartMenuFolder
    !insertmacro MUI_PAGE_INSTFILES

    # Uninstaller pages
    !insertmacro MUI_UNPAGE_CONFIRM
#    UninstPage custom un.UninstallOptions
    !insertmacro MUI_UNPAGE_INSTFILES

#--------------------------------
# Languages

    !insertmacro MUI_LANGUAGE "English"

#--------------------------------
# Installer initialisation

Function .onInit
    SetRegView 64

    # Only look for a remembered installation folder if the placeholder is
    # still in place, that is if there was no /D= on the command line.
    # An explicit /D= is always respected, even if it names the default.
    ${If} $INSTDIR == "${INSTDIR_PLACEHOLDER}"
        StrCpy $INSTDIR "${DEFAULT_INSTDIR}"
        ReadRegStr $0 HKLM "${UNINST_KEY}" "InstallLocation"
        ${If} $0 == ""
            # legacy location written by earlier installers
            ReadRegStr $0 HKCU "Software\Smtk2ssrf" ""
        ${EndIf}
        # only use it if Smtk2ssrf is actually installed there
        ${If} $0 != ""
            ${If} ${FileExists} "$0\smtk2ssrf.exe"
            ${OrIf} ${FileExists} "$0\Uninstall_smtk2ssrf.exe"
                StrCpy $INSTDIR $0
            ${EndIf}
        ${EndIf}
    ${EndIf}
FunctionEnd

#--------------------------------
# Uninstaller initialisation

Function un.onInit
    SetRegView 64
FunctionEnd

Section
    SetShellVarContext all

    # Installation path
    SetOutPath "$INSTDIR"

    # Delete any already installed DLLs to avoid buildup of various
    # versions of the same library when upgrading
    Delete "$INSTDIR\*.dll"

    # Files to include in installer
    # now that we install into the staging directory and try to only have
    # the DLLs there that we depend on, this is much easier
    File smtk2ssrf.exe
#    File /r data
#    File /r theme
#    File /r images
    File /r plugins
#    File /r Documentation
#    File /r translations
#    File /r printing_templates
    File *.dll
    File subsurface.ico
    File qt.conf

    # Create shortcuts
    !insertmacro MUI_STARTMENU_WRITE_BEGIN Application
        CreateDirectory "$SMPROGRAMS\$StartMenuFolder"
        CreateShortCut "$SMPROGRAMS\$StartMenuFolder\Smtk2ssrf.lnk" "$INSTDIR\smtk2ssrf.exe" "" "$INSTDIR\subsurface.ico" 0
        CreateShortCut "$SMPROGRAMS\$StartMenuFolder\Uninstall Smtk2ssrf.lnk" "$INSTDIR\Uninstall_smtk2ssrf.exe"
        CreateShortCut "$DESKTOP\Smtk2ssrf.lnk" "$INSTDIR\smtk2ssrf.exe" "" "$INSTDIR\subsurface.ico" 0
    !insertmacro MUI_STARTMENU_WRITE_END

    # Create the uninstaller
    WriteUninstaller "$INSTDIR\Uninstall_smtk2ssrf.exe"

    # Register the installation machine-wide, in the 64-bit registry view.
    # This also stores the installation folder, read back by .onInit.
    SetRegView 64
    ClearErrors
    WriteRegStr HKLM "${UNINST_KEY}" "DisplayName" "Smtk2ssrf"
    WriteRegStr HKLM "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\subsurface.ico"
    WriteRegStr HKLM "${UNINST_KEY}" "UninstallString" "$\"$INSTDIR\Uninstall_smtk2ssrf.exe$\""
    WriteRegStr HKLM "${UNINST_KEY}" "DisplayVersion" ${SUBSURFACE_VERSION}
    WriteRegStr HKLM "${UNINST_KEY}" "InstallLocation" "$INSTDIR"

    # NSIS does not abort when a registry write fails, it only sets the
    # error flag. Remove the legacy entries only once the machine-wide
    # registration is in place; otherwise keep them, as they are the only
    # registration of this installation.
    ${If} ${Errors}
        MessageBox MB_OK|MB_ICONEXCLAMATION "Smtk2ssrf could not be registered for all users. The existing registration has been left in place." /SD IDOK
    ${Else}
        # Remove the legacy per-user entries of the elevating account. Only
        # the default value of HKCU\Software\Smtk2ssrf is removed: the key
        # itself holds the Start Menu folder needed by the uninstaller.
        DeleteRegKey HKCU "${UNINST_KEY}"
        DeleteRegValue HKCU "Software\Smtk2ssrf" ""
    ${EndIf}

SectionEnd

#--------------------------------
# Uninstaller section

Section "Uninstall"
    SetShellVarContext all

    # Delete installed files
    Delete "$INSTDIR\*.dll"
    Delete "$INSTDIR\freetype-config"
    Delete "$INSTDIR\smtk2ssrf.exe"
    Delete "$INSTDIR\subsurface.ico"
    Delete "$INSTDIR\Uninstall_smtk2ssrf.exe"
    Delete "$INSTDIR\qt.conf"
#    RMDir /r "$INSTDIR\share"
#    RMDir /r "$INSTDIR\data"
#    RMDir /r "$INSTDIR\theme"
#    RMDir /r "$INSTDIR\images"
#    RMDir /r "$INSTDIR\translations"
#    RMDir /r "$INSTDIR\oldshare"
    RMDir /r "$INSTDIR\plugins"
#    RMDir /r "$INSTDIR\Documentation"
#    RMDir /r "$INSTDIR\printing_templates"
    RMDir "$INSTDIR"

    # Remove shortcuts
    !insertmacro MUI_STARTMENU_GETFOLDER Application $StartMenuFolder
    Delete "$SMPROGRAMS\$StartMenuFolder\Smtk2ssrf.lnk"
    Delete "$SMPROGRAMS\$StartMenuFolder\Uninstall Smtk2ssrf.lnk"
    RMDir "$SMPROGRAMS\$StartMenuFolder"
    Delete "$DESKTOP\Smtk2ssrf.lnk"

    # remove the registry entires
#    ${If} $Checkbox_Reg_State == 1
#        DeleteRegKey HKCU "Software\Smtk2ssrf"
#    ${EndIf}

    # remove the user directory
#    ${If} $Checkbox_UserDir_State == 1
#    ${AndIf} $UserDir != ""
#    ${AndIf} ${FileExists} "$UserDir\*.*"
#        RMDir /r $UserDir
#    ${EndIf}

    # remove the uninstaller entry, and the legacy per-user one. The
    # machine-wide entry is shared: a later installation into another
    # folder replaces it, so only remove it if it still names this folder.
    SetRegView 64
    ReadRegStr $0 HKLM "${UNINST_KEY}" "InstallLocation"
    ${If} $0 == ""
    ${OrIf} $0 == "$INSTDIR"
        DeleteRegKey HKLM "${UNINST_KEY}"
    ${EndIf}
    DeleteRegKey HKCU "${UNINST_KEY}"

SectionEnd
