#
# Subsurface NSIS installer script
#
# This installer creator needs to be run with:
# makensis subsurface.nsi
#

#--------------------------------
# Include Modern UI

    !include "MUI2.nsh"

#--------------------------------
# General

    # Program version
    !define SUBSURFACE_VERSION "VERSIONTOKEN"

    # VIProductVersion requires version in x.x.x.x format
    !define SUBSURFACE_VIPRODUCTVERSION "PRODVTOKEN"

    # Apps & Features (Uninstall) registry key, below HKLM (64-bit view)
    !define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Subsurface"

    # Installer name and filename
    Name "Subsurface"
    Caption "Subsurface ${SUBSURFACE_VERSION} Setup"
    OutFile "..\subsurface-${SUBSURFACE_VERSION}.exe"

    # Icon to use for the installer
    !define MUI_ICON "subsurface.ico"

    # Default installation folder
    !define DEFAULT_INSTDIR "$PROGRAMFILES64\Subsurface"

    # NSIS applies a /D= command line option to $INSTDIR before .onInit
    # runs, and removes it from $CMDLINE, so .onInit cannot tell a /D= that
    # names the default folder from no /D= at all. InstallDir therefore
    # holds a placeholder, which NSIS only uses when there is no valid /D=.
    # .onInit replaces it with the real default or the remembered folder.
    # The placeholder has no drive or share root, so it is never a valid
    # installation folder: NSIS discards a /D= naming it, as it discards
    # any invalid /D=, and no valid explicit folder can match it. It ends
    # in the application folder name, because NSIS takes the folder it
    # appends after Browse (D:\Apps becomes D:\Apps\Subsurface) from the text
    # after the last backslash of InstallDir.
    !define INSTDIR_PLACEHOLDER ".default-instdir\Subsurface"
    InstallDir "${INSTDIR_PLACEHOLDER}"

    # The remembered installation folder is looked up in .onInit, as
    # InstallDirRegKey cannot read the 64-bit registry view

    # Request application privileges
    RequestExecutionLevel admin

#--------------------------------
# Version information

    VIProductVersion "${SUBSURFACE_VIPRODUCTVERSION}"
    VIAddVersionKey "ProductName" "Subsurface"
    VIAddVersionKey "FileDescription" "Subsurface - an open source dive log program."
    VIAddVersionKey "FileVersion" "${SUBSURFACE_VERSION}"
    VIAddVersionKey "LegalCopyright" "GPL v.2"
    VIAddVersionKey "ProductVersion" "${SUBSURFACE_VERSION}"

#--------------------------------
# Settings

    # Show a warn on aborting installation
    !define MUI_ABORTWARNING

    # Defines the target start menu folder
    !define MUI_STARTMENUPAGE_REGISTRY_ROOT "HKCU"
    !define MUI_STARTMENUPAGE_REGISTRY_KEY "Software\Subsurface"
    !define MUI_STARTMENUPAGE_REGISTRY_VALUENAME "Start Menu Folder"

#--------------------------------
# Variables

    Var StartMenuFolder

#--------------------------------
# Custom pages

# Maintain some checkboxes in the uninstall dialog
Var UninstallDialog
Var Checkbox_Reg
Var Checkbox_Reg_State
Var Checkbox_UserDir
Var Checkbox_UserDir_State
Var UserDir

Function un.UninstallOptions
    nsDialogs::Create 1018
    Pop $UninstallDialog
    ${If} $UninstallDialog == error
        Abort
    ${EndIf}

    StrCpy $Checkbox_Reg_State 0
    StrCpy $Checkbox_UserDir 0

    # if this key exists Subsurface was run at least once
    ReadRegStr $UserDir HKCU "Software\Subsurface\Subsurface\GeneralSettings" "default_directory"
    ${If} $UserDir != ""
        # checkbox for removing registry entries
        ${NSD_CreateCheckbox} 0 0u 100% 20u "Registry entries (HKEY_CURRENT_USER\Software\Subsurface)"
        Pop $Checkbox_Reg
        GetFunctionAddress $0 un.OnCheckbox_Reg
        nsDialogs::OnClick $Checkbox_Reg $0

        ${If} ${FileExists} "$UserDir\*.*"
            # checkbox for removing the user directory
            ${NSD_CreateCheckbox} 0 20u 100% 20u "User directory ($UserDir)"
            Pop $Checkbox_UserDir
            GetFunctionAddress $0 un.OnCheckbox_UserDir
            nsDialogs::OnClick $Checkbox_UserDir $0
       ${EndIf}
    ${EndIf}

    nsDialogs::Show
FunctionEnd

Function un.OnCheckbox_Reg
    ${NSD_GetState} $Checkbox_Reg $Checkbox_Reg_State
FunctionEnd
Function un.OnCheckbox_UserDir
    ${NSD_GetState} $Checkbox_UserDir $Checkbox_UserDir_State
    ${If} $Checkbox_UserDir_State == 1
       MessageBox MB_OK "WARNING!$\nMake sure you don't have important files in the user directory!"
    ${EndIf}
FunctionEnd

#--------------------------------
# Pages

    # Installer pages
    !insertmacro MUI_PAGE_LICENSE "gpl-2.0.txt"
    !insertmacro MUI_PAGE_DIRECTORY
    !insertmacro MUI_PAGE_STARTMENU Application $StartMenuFolder
    !insertmacro MUI_PAGE_INSTFILES

    # Uninstaller pages
    !insertmacro MUI_UNPAGE_CONFIRM
    UninstPage custom un.UninstallOptions
    !insertmacro MUI_UNPAGE_INSTFILES

#--------------------------------
# Languages

    !insertmacro MUI_LANGUAGE "English"

#--------------------------------
# Installer initialisation

Function .onInit
    SetRegView 64

    # Only look for a remembered installation folder if the placeholder is
    # still in place, that is if there was no /D= on the command line.
    # An explicit /D= is always respected, even if it names the default.
    ${If} $INSTDIR == "${INSTDIR_PLACEHOLDER}"
        StrCpy $INSTDIR "${DEFAULT_INSTDIR}"
        ReadRegStr $0 HKLM "${UNINST_KEY}" "InstallLocation"
        ${If} $0 == ""
            # legacy location written by installers up to and including 6.0.x
            ReadRegStr $0 HKCU "Software\Subsurface" ""
        ${EndIf}
        # only use it if Subsurface is actually installed there
        ${If} $0 != ""
        ${AndIf} ${FileExists} "$0\subsurface.exe"
            StrCpy $INSTDIR $0
        ${EndIf}
    ${EndIf}
FunctionEnd

#--------------------------------
# Uninstaller initialisation

Function un.onInit
    SetRegView 64
FunctionEnd

#--------------------------------
# Stale per-user Uninstall entries of other accounts
#
# Older installers wrote the Apps & Features entry below HKCU of the
# account that approved the UAC prompt. When that is not the account
# using the installer, the entry sits in the hive of another user, which
# Windows keeps loaded below HKEY_USERS while that user is logged on.
# Remove such entries from every loaded hive, but only if they are
# recognisably ours: DisplayName is exactly "Subsurface" and the
# uninstaller they reference is the one in this installation folder. The
# path is compared as a string only. It is never probed with FileExists:
# the other user controls it, so a probe could make this elevated process
# contact a network share (a UNC path, or a symbolic link to one), and a
# failed probe cannot tell a missing file from an unavailable volume.
# Hives of users who are logged off are not loaded and are not handled.
# HKU\<SID>\Software\Subsurface (the user's settings) is never touched.
# Failures (some hives deny writes) are ignored.

!macro RemoveStaleUserEntries un
Function ${un}RemoveStaleUserEntries
    Push $0
    Push $1
    Push $2
    Push $3
    Push $4

    StrCpy $0 0
    ${Do}
        ClearErrors
        EnumRegKey $1 HKU "" $0
        ${If} ${Errors}
        ${OrIf} $1 == ""
            ${Break}
        ${EndIf}
        IntOp $0 $0 + 1

        # skip the HKCU\Software\Classes hives (<SID>_Classes)
        StrCpy $2 $1 8 -8
        ${If} $2 != "_Classes"
            ClearErrors
            ReadRegStr $2 HKU "$1\${UNINST_KEY}" "DisplayName"
            ${IfNot} ${Errors}
            ${AndIf} $2 S== "Subsurface"
                ReadRegStr $3 HKU "$1\${UNINST_KEY}" "UninstallString"
                # tolerate the quoted form as well as the legacy unquoted one
                StrCpy $4 $3 1
                ${If} $4 == "$\""
                    StrCpy $3 $3 "" 1
                    StrCpy $4 $3 1 -1
                    ${If} $4 == "$\""
                        StrCpy $3 $3 -1
                    ${EndIf}
                ${EndIf}
                ${If} $3 != ""
                ${AndIf} $3 == "$INSTDIR\Uninstall.exe"
                    DeleteRegKey HKU "$1\${UNINST_KEY}"
                ${EndIf}
            ${EndIf}
        ${EndIf}
    ${Loop}

    ClearErrors
    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Pop $0
FunctionEnd
!macroend

!insertmacro RemoveStaleUserEntries ""
!insertmacro RemoveStaleUserEntries "un."

Section
    SetShellVarContext all

    # Installation path
    SetOutPath "$INSTDIR"

    # Delete any already installed DLLs to avoid buildup of various
    # versions of the same library when upgrading
    Delete "$INSTDIR\*.dll"

    # Files to include in installer
    # now that we install into the staging directory and try to only have
    # the DLLs there that we depend on, this is much easier
    File subsurface.exe
    File /nonfatal /r theme
    File /nonfatal /r plugins
    File /nonfatal /r qml
    File /nonfatal /r Documentation
    File /nonfatal /r translations
    File /nonfatal /r printing_templates
    File /nonfatal *.dll
    File subsurface.ico
    File /nonfatal qt.conf

    # Create shortcuts
    !insertmacro MUI_STARTMENU_WRITE_BEGIN Application
        CreateDirectory "$SMPROGRAMS\$StartMenuFolder"
        CreateShortCut "$SMPROGRAMS\$StartMenuFolder\Subsurface.lnk" "$INSTDIR\subsurface.exe" "" "$INSTDIR\subsurface.ico" 0
        CreateShortCut "$SMPROGRAMS\$StartMenuFolder\Uninstall Subsurface.lnk" "$INSTDIR\Uninstall.exe"
        CreateShortCut "$DESKTOP\Subsurface.lnk" "$INSTDIR\subsurface.exe" "" "$INSTDIR\subsurface.ico" 0
    !insertmacro MUI_STARTMENU_WRITE_END

    # Create the uninstaller
    WriteUninstaller "$INSTDIR\Uninstall.exe"

    # Register the installation machine-wide, in the 64-bit registry view.
    # This also stores the installation folder, read back by .onInit.
    SetRegView 64
    ClearErrors
    WriteRegStr HKLM "${UNINST_KEY}" "DisplayName" "Subsurface"
    WriteRegStr HKLM "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\subsurface.ico"
    WriteRegStr HKLM "${UNINST_KEY}" "UninstallString" "$\"$INSTDIR\Uninstall.exe$\""
    WriteRegStr HKLM "${UNINST_KEY}" "DisplayVersion" ${SUBSURFACE_VERSION}
    WriteRegStr HKLM "${UNINST_KEY}" "InstallLocation" "$INSTDIR"

    # NSIS does not abort when a registry write fails, it only sets the
    # error flag. Remove the legacy entries only once the machine-wide
    # registration is in place; otherwise keep them, as they are the only
    # registration of this installation.
    ${If} ${Errors}
        MessageBox MB_OK|MB_ICONEXCLAMATION "Subsurface could not be registered for all users. The existing registration has been left in place." /SD IDOK
    ${Else}
        # Remove the legacy per-user entries of the elevating account. Only
        # the default value of HKCU\Software\Subsurface is removed: the key
        # itself holds the application settings (in its Subsurface subkey)
        # and the Start Menu folder.
        DeleteRegKey HKCU "${UNINST_KEY}"
        DeleteRegValue HKCU "Software\Subsurface" ""

        # ... and those of other logged-on accounts
        Call RemoveStaleUserEntries
    ${EndIf}

SectionEnd

#--------------------------------
# Uninstaller section

Section "Uninstall"
    SetShellVarContext all

    # Delete installed files
    Delete "$INSTDIR\*.dll"
    Delete "$INSTDIR\freetype-config"
    Delete "$INSTDIR\subsurface.exe"
    Delete "$INSTDIR\subsurface.ico"
    Delete "$INSTDIR\Uninstall.exe"
    Delete "$INSTDIR\qt.conf"
    RMDir /r "$INSTDIR\share"
    RMDir /r "$INSTDIR\data"
    RMDir /r "$INSTDIR\theme"
    RMDir /r "$INSTDIR\translations"
    RMDir /r "$INSTDIR\oldshare"
    RMDir /r "$INSTDIR\plugins"
    RMDir /r "$INSTDIR\qml"
    RMDir /r "$INSTDIR\Documentation"
    RMDir /r "$INSTDIR\printing_templates"
    RMDir "$INSTDIR"

    # Remove shortcuts
    !insertmacro MUI_STARTMENU_GETFOLDER Application $StartMenuFolder
    Delete "$SMPROGRAMS\$StartMenuFolder\Subsurface.lnk"
    Delete "$SMPROGRAMS\$StartMenuFolder\Uninstall Subsurface.lnk"
    RMDir "$SMPROGRAMS\$StartMenuFolder"
    Delete "$DESKTOP\Subsurface.lnk"

    # remove the registry entires
    ${If} $Checkbox_Reg_State == 1
        DeleteRegKey HKCU "Software\Subsurface"
    ${EndIf}

    # remove the user directory
    ${If} $Checkbox_UserDir_State == 1
    ${AndIf} $UserDir != ""
    ${AndIf} ${FileExists} "$UserDir\*.*"
        RMDir /r $UserDir
    ${EndIf}

    # remove the uninstaller entry, and the legacy per-user one. The
    # machine-wide entry is shared: a later installation into another
    # folder replaces it, so only remove it if it still names this folder.
    ReadRegStr $0 HKLM "${UNINST_KEY}" "InstallLocation"
    ${If} $0 == ""
    ${OrIf} $0 == "$INSTDIR"
        DeleteRegKey HKLM "${UNINST_KEY}"
    ${EndIf}
    DeleteRegKey HKCU "${UNINST_KEY}"
    Call un.RemoveStaleUserEntries

SectionEnd
