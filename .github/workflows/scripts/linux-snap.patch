diff --git a/snap/snapcraft.yaml b/snap/snapcraft.yaml
--- a/snap/snapcraft.yaml
+++ b/snap/snapcraft.yaml
@@ -39,8 +39,9 @@
     plugin: nil
     build-packages:
     - build-essential
+    - ccache
