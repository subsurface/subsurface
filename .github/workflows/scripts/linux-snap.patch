diff --git a/snap/snapcraft.yaml b/snap/snapcraft.yaml
--- a/snap/snapcraft.yaml
+++ b/snap/snapcraft.yaml
@@ -62,8 +62,9 @@ parts:
     plugin: nil
     build-packages:
     - build-essential
+    - ccache
     override-build: |
-      qmake6 CONFIG+=release ${CRAFT_PART_SRC}
+      qmake6 CONFIG+=release CONFIG+=ccache ${CRAFT_PART_SRC}
       make -j${CRAFT_PARALLEL_BUILD_COUNT}
       # this is a private plugin, so install it where our Qt 6 will find it,
       # independent of where the SDK's qmake wants to put plugins
@@ -105,7 +106,11 @@ parts:
     # "C compiler cannot create executables". Use the system compiler instead.
     build-environment:
     - CC: /usr/bin/gcc
+    autotools-configure-parameters:
+    - CC="ccache /usr/bin/gcc"
+    - CXX="ccache g++"
     build-packages:
+    - ccache
     - libbluetooth-dev
     - libhidapi-dev
     - libusb-dev
@@ -131,8 +136,11 @@ parts:
     - -DCMAKE_EXE_LINKER_FLAGS=-Llink-stubs
     - -DBUILD_WITH_QT6=ON
     - -DCMAKE_PREFIX_PATH=../../../stage/usr/local
+    - -DCMAKE_C_COMPILER_LAUNCHER=ccache
+    - -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
     build-packages:
     - build-essential
+    - ccache
     - libcurl4-gnutls-dev
     - libftdi1-dev
     - libgit2-dev
